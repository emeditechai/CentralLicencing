@model CentralLicenceApp.Models.EnquiryClient
@{
    ViewData["Title"] = Model.CompanyName;
    var enquiries = (List<CentralLicenceApp.Models.Enquiry>)ViewBag.Enquiries;
}
<partial name="_EnquiryStyles" />
<div class="eq-head">
    <div class="eq-title"><div class="eq-title-icon"><i class="bi bi-building"></i></div><div><h4>@Model.CompanyName</h4><p>@Model.ClientCode @(string.IsNullOrWhiteSpace(Model.BusinessTypeName) ? "" : "· " + Model.BusinessTypeName)</p></div></div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <a asp-action="Edit" asp-route-id="@Model.Id" asp-permission="EnquiryClient:Edit" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" asp-permission="EnquiryClient:Edit">@Html.AntiForgeryToken()<input type="hidden" name="active" value="@(!Model.IsActive ? "true" : "false")" /><button class="btn btn-outline-warning">@(Model.IsActive ? "Deactivate" : "Activate")</button></form>
        <a asp-controller="ClientEnquiry" asp-action="Create" asp-route-clientId="@Model.Id" asp-permission="ClientEnquiry:Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Enquiry</a>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-4"><div class="eq-card"><div class="eq-card-head">Details</div><div class="eq-card-body" style="font-size:.86rem;">
        @foreach (var (label, value) in new[] { ("GSTIN", Model.GSTIN), ("Address", Model.Address), ("City", Model.City), ("State", Model.State), ("Website", Model.Website), ("Existing software", Model.ExistingSoftware), ("Size", Model.SizeInfo), ("Referred by", Model.ReferredBy), ("Linked Client Details", Model.LinkedClientCode), ("Notes", Model.Notes) })
        {
            if (!string.IsNullOrWhiteSpace(value)) { <div class="eq-label">@label</div><div class="mb-2" style="white-space:pre-line;">@value</div> }
        }
    </div></div></div>
    <div class="col-lg-8">
        <div class="eq-card mb-3"><div class="eq-card-head">Contacts</div><div class="table-responsive"><table class="table eq-table mb-0">
            <thead><tr><th>Name</th><th>Role</th><th>Mobile</th><th>WhatsApp</th><th>Email</th></tr></thead>
            <tbody>@foreach (var k in Model.Contacts) { <tr><td>@k.Name @(k.IsPrimary ? "★" : "")</td><td>@k.Role</td><td>@k.Mobile</td><td>@k.WhatsApp @(k.WhatsAppOptOut ? "(opted out)" : "")</td><td>@k.Email</td></tr> }</tbody>
        </table></div></div>
        <div class="eq-card"><div class="eq-card-head">Enquiries</div><div class="table-responsive"><table class="table eq-table mb-0">
            <thead><tr><th>Enquiry</th><th>Products</th><th>Stage</th><th>Owner</th><th>Next follow-up</th></tr></thead>
            <tbody>
                @if (!enquiries.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">No enquiries yet.</td></tr> }
                @foreach (var e in enquiries) { <tr><td><a asp-controller="ClientEnquiry" asp-action="Details" asp-route-id="@e.Id" class="fw-semibold text-decoration-none">@e.EnquiryNo</a><div class="eq-sub">@e.Title</div></td><td class="eq-sub">@e.ProductNames</td><td><span class="eq-pill" style="color:@e.StageColor;">@e.StageName</span></td><td>@e.OwnerName</td><td>@(e.NextFollowUpAt?.ToString("dd MMM hh:mm tt") ?? "—")</td></tr> }
            </tbody>
        </table></div></div>
    </div>
</div>
