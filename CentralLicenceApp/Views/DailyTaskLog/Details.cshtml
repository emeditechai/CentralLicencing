@model CentralLicenceApp.Models.DailyTaskLog
@{
    ViewData["Title"] = "Task Details";
    var timeLogs = (List<CentralLicenceApp.Models.TaskTimeLog>)ViewBag.TimeLogs;
    var attachments = (List<CentralLicenceApp.Models.TaskAttachment>)(ViewBag.Attachments ?? new List<CentralLicenceApp.Models.TaskAttachment>());
    bool isCoreMember = ViewBag.IsCoreMember ?? false;
    int currentUserId = ViewBag.CurrentUserId ?? 0;
    bool canEditDelete = isCoreMember || Model.UserId == currentUserId || Model.AssignedToUserId == currentUserId;
    var statusCls = Model.Status == "Completed" ? "td-status-completed" : Model.Status == "In Progress" ? "td-status-inprogress" : Model.Status == "Started" ? "td-status-started" : Model.Status == "On Hold" ? "td-status-onhold" : "td-status-pending";
    var typeCls = Model.TaskTypeName == "Development" ? "td-type-dev" : "td-type-sup";
}

<link rel="stylesheet" href="https://unpkg.com/tributejs@5.1.3/dist/tribute.css">
<style>
    .td-hero { background:linear-gradient(135deg,#667eea 0%,#764ba2 100%); border-radius:20px; padding:1.75rem 2rem; margin-bottom:1.75rem; position:relative; overflow:hidden; }
    .td-hero::before { content:''; position:absolute; top:-50%; right:-8%; width:280px; height:280px; background:rgba(255,255,255,.06); border-radius:50%; pointer-events:none; }
    .td-hero::after { content:''; position:absolute; bottom:-35%; left:15%; width:220px; height:220px; background:rgba(255,255,255,.04); border-radius:50%; pointer-events:none; }
    .td-hero h4 { color:#fff; font-weight:800; font-size:1.35rem; margin-bottom:.2rem; }
    .td-hero .td-sub { color:rgba(255,255,255,.7); font-size:.83rem; }

    .td-card { background:#fff; border-radius:16px; box-shadow:0 2px 16px rgba(0,0,0,.05); border:1px solid #f1f5f9; margin-bottom:1.5rem; }
    .td-card .card-body { padding:1.75rem 2rem; }
    .td-section-lbl { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#6366f1; margin-bottom:.75rem; padding-bottom:.35rem; border-bottom:2px solid #ede9fe; }

    .td-field-label { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#94a3b8; margin-bottom:.2rem; }
    .td-field-value { font-size:.88rem; font-weight:600; color:#1e293b; margin-bottom:1rem; }
    .td-field-value.td-muted { color:#94a3b8; font-weight:500; }

    .td-type-badge { font-size:.72rem; font-weight:700; padding:4px 12px; border-radius:20px; letter-spacing:.03em; }
    .td-type-dev { background:linear-gradient(135deg,#ede9fe,#ddd6fe); color:#5b21b6; }
    .td-type-sup { background:linear-gradient(135deg,#dbeafe,#bfdbfe); color:#1e40af; }
    .td-cat-badge { font-size:.72rem; font-weight:600; padding:4px 10px; border-radius:8px; background:#f1f5f9; color:#475569; }

    .td-status { font-size:.75rem; font-weight:700; padding:5px 14px; border-radius:20px; letter-spacing:.03em; }
    .td-status-pending { background:linear-gradient(135deg,#fef9c3,#fde68a); color:#92400e; }
    .td-status-started { background:linear-gradient(135deg,#e0e7ff,#c7d2fe); color:#3730a3; }
    .td-status-inprogress { background:linear-gradient(135deg,#dbeafe,#93c5fd); color:#1e40af; }
    .td-status-onhold { background:linear-gradient(135deg,#fee2e2,#fecaca); color:#991b1b; }
    .td-status-completed { background:linear-gradient(135deg,#dcfce7,#bbf7d0); color:#166534; }

    .td-time-card { background:linear-gradient(135deg,#f5f3ff,#ede9fe); border:1.5px solid #ddd6fe; border-radius:14px; padding:1rem 1.25rem; text-align:center; }
    .td-time-card .td-time-num { font-size:1.5rem; font-weight:800; color:#5b21b6; line-height:1.2; }
    .td-time-card .td-time-lbl { font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; font-weight:600; color:#7c3aed; }

    .td-log-row { background:#f8fafc; border-radius:10px; padding:.65rem .85rem; margin-bottom:.4rem; display:flex; align-items:center; justify-content:space-between; border:1px solid #f1f5f9; transition:background .15s; }
    .td-log-row:hover { background:#f5f3ff; border-color:#e8e4f8; }
    .td-log-date { font-weight:700; font-size:.82rem; color:#1e293b; min-width:100px; }
    .td-log-time-pill { background:linear-gradient(135deg,#ede9fe,#ddd6fe); color:#5b21b6; font-weight:700; font-size:.75rem; padding:3px 10px; border-radius:20px; white-space:nowrap; }
    .td-log-remark { font-size:.8rem; color:#64748b; flex:1; margin:0 .75rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .td-log-user { font-size:.72rem; color:#94a3b8; font-weight:600; min-width:80px; text-align:right; }

    .td-btn-edit { background:linear-gradient(135deg,#6366f1,#4f46e5); border:none; border-radius:10px; font-weight:700; padding:.45rem 1.1rem; font-size:.82rem; color:#fff; box-shadow:0 3px 10px rgba(99,102,241,.3); transition:all .2s; text-decoration:none; }
    .td-btn-edit:hover { transform:translateY(-1px); box-shadow:0 5px 16px rgba(99,102,241,.4); color:#fff; }
    .td-btn-back { border-radius:10px; font-weight:600; font-size:.82rem; border:1.5px solid #e2e8f0; color:#64748b; padding:.45rem 1.1rem; text-decoration:none; }
    .td-btn-back:hover { border-color:#94a3b8; color:#1e293b; }

    .td-desc-box { background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; padding:.85rem 1rem; font-size:.85rem; color:#475569; line-height:1.6; white-space:pre-wrap; }

    /* ── Attachment styles ── */
    .td-att-grid { display:flex; flex-direction:column; gap:.4rem; }
    .td-att-row { display:flex; align-items:center; gap:.75rem; background:#f8fafc; border:1px solid #f1f5f9; border-radius:12px; padding:.65rem 1rem; transition:background .15s, border-color .15s; }
    .td-att-row:hover { background:#f5f3ff; border-color:#ddd6fe; }
    .td-att-icon-wrap { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:1.3rem; }
    .td-att-icon-wrap.pdf { background:linear-gradient(135deg,#fee2e2,#fecaca); }
    .td-att-icon-wrap.img { background:linear-gradient(135deg,#ede9fe,#ddd6fe); }
    .td-att-info { flex:1; overflow:hidden; }
    .td-att-name { font-size:.84rem; font-weight:700; color:#1e293b; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-decoration:none; display:block; }
    .td-att-name:hover { color:#6366f1; }
    .td-att-meta { font-size:.72rem; color:#94a3b8; margin-top:.1rem; }
    .td-att-actions { display:flex; gap:.4rem; flex-shrink:0; }
    .td-att-btn { border:none; background:none; padding:.3rem .5rem; border-radius:8px; cursor:pointer; font-size:.82rem; transition:background .15s; text-decoration:none; display:inline-flex; align-items:center; gap:.25rem; font-weight:600; }
    .td-att-btn.view { color:#6366f1; }
    .td-att-btn.view:hover { background:#ede9fe; color:#4f46e5; }
    .td-att-btn.del { color:#ef4444; }
    .td-att-btn.del:hover { background:#fee2e2; color:#dc2626; }

    /* ── Lightbox ── */
    .td-lightbox { position:fixed; inset:0; background:rgba(0,0,0,.85); z-index:9999; display:flex; align-items:center; justify-content:center; animation:fadeInLb .2s; }
    @@keyframes fadeInLb { from { opacity:0; } to { opacity:1; } }
    .td-lightbox img { max-width:90vw; max-height:90vh; border-radius:12px; box-shadow:0 20px 60px rgba(0,0,0,.5); }
    .td-lightbox-close { position:absolute; top:1rem; right:1.25rem; color:#fff; font-size:2rem; cursor:pointer; line-height:1; background:none; border:none; }
    .td-att-count-badge { background:linear-gradient(135deg,#6366f1,#4f46e5); color:#fff; font-size:.7rem; font-weight:700; padding:2px 8px; border-radius:20px; margin-left:.5rem; vertical-align:middle; }
</style>

@* Hidden CSRF token for AJAX calls on this page *@
@Html.AntiForgeryToken()
<input type="hidden" id="td-csrf" value="" />
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        if (t) document.getElementById('td-csrf').value = t.value;
    });
</script>

<!-- ─── Hero ─── -->
<div class="td-hero">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3" style="position:relative;z-index:1;">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-sm" style="background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:10px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4><i class="bi bi-journal-text me-2" style="opacity:.85;"></i>Task Details</h4>
                <div class="td-sub">View task information, reference, attachments, and time log history</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (canEditDelete)
            {
                <a asp-action="Edit" asp-permission="DailyTaskLog:Edit" asp-route-id="@Model.Id" class="td-btn-edit"><i class="bi bi-pencil-square me-1"></i> Edit Task</a>
            }
        </div>
    </div>
</div>

<!-- ─── Task Info Card ─── -->
<div class="td-card">
    <div class="card-body">
        <div class="td-section-lbl"><i class="bi bi-info-circle me-1"></i> Basic Information</div>
        <div class="row">
            <div class="col-md-8">
                <div class="td-field-label">Task Title</div>
                @if (!string.IsNullOrWhiteSpace(Model.TaskNumber))
                {
                    <div style="font-size:0.85rem; font-weight:700; color:#6366f1; margin-bottom:4px;"><i class="bi bi-hash"></i>@Model.TaskNumber</div>
                }
                <div class="td-field-value" style="font-size:1rem;">@Model.TaskTitle</div>
            </div>
            <div class="col-md-4 text-md-end">
                <span class="td-status @statusCls">@Model.Status</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="td-field-label">Task Date</div>
                <div class="td-field-value"><i class="bi bi-calendar3 me-1 text-muted"></i>@Model.TaskDate.ToString("dd MMM yyyy")</div>
            </div>
            <div class="col-md-3">
                <div class="td-field-label">Task Type</div>
                <div class="td-field-value"><span class="td-type-badge @typeCls">@Model.TaskTypeName</span></div>
            </div>
            <div class="col-md-3">
                <div class="td-field-label">Category</div>
                <div class="td-field-value"><span class="td-cat-badge">@Model.TaskCategoryName</span></div>
            </div>
            <div class="col-md-3">
                <div class="td-field-label">Created By</div>
                <div class="td-field-value"><i class="bi bi-person me-1 text-muted"></i>@Model.UserName</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="td-field-label">Assigned To</div>
                <div class="td-field-value @(string.IsNullOrWhiteSpace(Model.AssignedToUserName) ? "td-muted" : "")">
                    @if (!string.IsNullOrWhiteSpace(Model.AssignedToUserName))
                    {
                        <i class="bi bi-person-check me-1" style="color:#6366f1;"></i>@Model.AssignedToUserName
                    }
                    else
                    {
                        <text>— Unassigned —</text>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="td-field-label">Created At</div>
                <div class="td-field-value" style="font-size:.82rem;">@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
            <div class="col-md-3">
                <div class="td-field-label">Last Updated</div>
                <div class="td-field-value @(Model.UpdatedAt == null ? "td-muted" : "")" style="font-size:.82rem;">
                    @(Model.UpdatedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="td-field-label">Description</div>
            <div class="td-desc-box">@Html.Raw(Model.Description)</div>
        }
    </div>
</div>

<!-- ─── Reference Card ─── -->
@if (Model.TicketId.HasValue || Model.ProjectModuleId.HasValue)
{
    <div class="td-card">
        <div class="card-body">
            <div class="td-section-lbl"><i class="bi bi-link-45deg me-1"></i> Reference</div>
            <div class="row">
                @if (Model.TicketId.HasValue)
                {
                    <div class="col-md-6">
                        <div class="td-field-label">Linked Ticket</div>
                        <div class="td-field-value">
                            <span style="background:#ede9fe;color:#6366f1;font-size:.78rem;font-weight:700;padding:4px 10px;border-radius:8px;">
                                <i class="bi bi-ticket-perforated me-1"></i>@Model.TicketNumber
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.TicketSubject))
                            {
                                <span class="ms-2" style="font-size:.82rem;color:#475569;">@Model.TicketSubject</span>
                            }
                        </div>
                    </div>
                }
                @if (Model.ProjectModuleId.HasValue)
                {
                    <div class="col-md-6">
                        <div class="td-field-label">Project / Module</div>
                        <div class="td-field-value">
                            <span style="background:#ecfdf5;color:#059669;font-size:.78rem;font-weight:700;padding:4px 10px;border-radius:8px;">
                                <i class="bi bi-folder me-1"></i>@Model.ProjectModuleName
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ─── Attachments Card ─── -->
<div class="td-card">
    <div class="card-body">
        <div class="td-section-lbl">
            <i class="bi bi-paperclip me-1"></i> Attachments
            @if (attachments.Any())
            {
                <span class="td-att-count-badge">@attachments.Count</span>
            }
        </div>

        @if (attachments.Any())
        {
            <div class="td-att-grid" id="attGrid">
                @foreach (var att in attachments)
                {
                    var isPdf = att.OriginalName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                    var iconHtml = isPdf ? "<i class='bi bi-file-earmark-pdf' style='color:#ef4444;'></i>" : "<i class='bi bi-file-earmark-image' style='color:#6366f1;'></i>";
                    var wrapCls = isPdf ? "pdf" : "img";
                    var sizeStr = att.FileSize < 1024 * 1024
                        ? $"{(att.FileSize / 1024.0):0.0} KB"
                        : $"{(att.FileSize / (1024.0 * 1024)):0.0} MB";

                    <div class="td-att-row" id="td-att-@att.Id">
                        <div class="td-att-icon-wrap @wrapCls">
                            @Html.Raw(iconHtml)
                        </div>
                        <div class="td-att-info">
                            <a href="@att.FilePath" target="_blank" class="td-att-name" title="@att.OriginalName">@att.OriginalName</a>
                            <div class="td-att-meta">
                                @sizeStr &nbsp;·&nbsp;
                                <i class="bi bi-person me-1"></i>@att.UploadedByName &nbsp;·&nbsp;
                                @att.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                        <div class="td-att-actions">
                            @if (!isPdf)
                            {
                                <button type="button" class="td-att-btn view" onclick="openLightbox('@att.FilePath', '@att.OriginalName.Replace("'", "\\'")')" title="Preview image">
                                    <i class="bi bi-eye"></i> Preview
                                </button>
                            }
                            else
                            {
                                <a href="@att.FilePath" target="_blank" class="td-att-btn view" title="Open PDF">
                                    <i class="bi bi-box-arrow-up-right"></i> Open
                                </a>
                            }
                            @if (canEditDelete)
                            {
                                <button type="button" class="td-att-btn del" onclick="deleteAttachment(@att.Id)" title="Delete attachment">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4" style="color:#94a3b8;">
                <i class="bi bi-paperclip" style="font-size:2rem;display:block;margin-bottom:.5rem;color:#cbd5e1;"></i>
                <div style="font-size:.85rem;">No attachments uploaded for this task.</div>
                @if (canEditDelete)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm mt-2" style="background:#ede9fe;color:#6366f1;border-radius:8px;font-weight:600;font-size:.78rem;">
                        <i class="bi bi-plus-circle me-1"></i>Add Attachments
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- ─── Time Effort Card ─── -->
<div class="td-card">
    <div class="card-body">
        <div class="td-section-lbl"><i class="bi bi-clock-history me-1"></i> Time Effort</div>

        <!-- Summary Stats -->
        <div class="d-flex gap-3 flex-wrap mb-4">
            <div class="td-time-card" style="min-width:120px;">
                <div class="td-time-num">@FormatTime(Model.TotalTimeSpentMinutes)</div>
                <div class="td-time-lbl">Total Effort</div>
            </div>
            <div class="td-time-card" style="min-width:120px;">
                <div class="td-time-num">@Model.TimeLogCount</div>
                <div class="td-time-lbl">Time Entries</div>
            </div>
            @if (Model.LastLogDate.HasValue)
            {
                <div class="td-time-card" style="min-width:120px;">
                    <div class="td-time-num" style="font-size:1rem;">@Model.LastLogDate.Value.ToString("dd MMM")</div>
                    <div class="td-time-lbl">Last Logged</div>
                </div>
            }
        </div>

        <!-- Time Log Entries -->
        @if (timeLogs.Any())
        {
            <div class="td-field-label mb-2">Time Log History</div>
            @foreach (var log in timeLogs)
            {
                <div class="td-log-row">
                    <span class="td-log-date">@log.LogDate.ToString("dd MMM yyyy")</span>
                    <span class="td-log-time-pill">@FormatTime(log.TimeSpentMinutes)</span>
                    <span class="td-log-remark">@(string.IsNullOrWhiteSpace(log.Remarks) ? "—" : log.Remarks)</span>
                    <span class="td-log-user">@log.UserName</span>
                </div>
            }
        }
        else
        {
            <div class="text-center py-3" style="color:#94a3b8;font-size:.85rem;">
                <i class="bi bi-clock" style="font-size:1.5rem;display:block;margin-bottom:.5rem;color:#cbd5e1;"></i>
                No time logged yet.
            </div>
        }
    </div>
</div>

<!-- ─── Comments Card ─── -->
@{
    var comments = ViewBag.Comments as List<CentralLicenceApp.Models.TaskComment> ?? new List<CentralLicenceApp.Models.TaskComment>();
}
<div class="td-card">
    <div class="card-body">
        <div class="td-section-lbl"><i class="bi bi-chat-dots me-1"></i> Comments &amp; Activity</div>
        
        @if (comments.Any())
        {
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var comment in comments)
                {
                    <div class="d-flex gap-2">
                        <div class="flex-shrink-0">
                            @if (!string.IsNullOrWhiteSpace(comment.ProfileImagePath))
                            {
                                <img src="@Url.Content(comment.ProfileImagePath)" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width:36px;height:36px;background:#6366f1;font-weight:bold;font-size:14px;">
                                    @(comment.UserName.Substring(0, 1).ToUpper())
                                </div>
                            }
                        </div>
                        <div style="background:#f8fafc; border:1px solid #f1f5f9; border-radius:12px; padding:12px 16px; width:100%;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span style="font-size:0.85rem; font-weight:700; color:#1e293b;">@comment.UserName</span>
                                <span style="font-size:0.75rem; color:#94a3b8;"><i class="bi bi-clock me-1"></i>@comment.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                            <div style="font-size:0.85rem; color:#475569;">
                                @Html.Raw(comment.CommentText)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-3 mb-4" style="color:#94a3b8;font-size:.85rem;">
                <i class="bi bi-chat" style="font-size:1.5rem;display:block;margin-bottom:.5rem;color:#cbd5e1;"></i>
                No comments yet. Start the conversation!
            </div>
        }

        <div class="mt-3 pt-3" style="border-top:1px solid #f1f5f9;">
            <form asp-action="AddComment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TaskId" value="@Model.Id" />
                <div class="mb-2">
                    <textarea id="commentInput" name="CommentText" class="form-control" rows="2" placeholder="Write a comment..." style="border-radius:12px; font-size:0.85rem; border:1px solid #e2e8f0;" required></textarea>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-sm" style="background:#6366f1; color:#fff; border-radius:8px; font-weight:600; padding:0.4rem 1rem;">
                        <i class="bi bi-send-fill me-1"></i> Post Comment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ─── Bottom Actions ─── -->
<div class="d-flex gap-2 mb-4">
    <a asp-action="Index" class="td-btn-back"><i class="bi bi-arrow-left me-1"></i> Back to Tasks</a>
    @if (canEditDelete)
    {
        <a asp-action="Edit" asp-permission="DailyTaskLog:Edit" asp-route-id="@Model.Id" class="td-btn-edit"><i class="bi bi-pencil-square me-1"></i> Edit Task</a>
    }
</div>

<!-- ─── Image Lightbox ─── -->
<div class="td-lightbox" id="lightbox" style="display:none;" onclick="closeLightbox()">
    <button class="td-lightbox-close" onclick="closeLightbox()">&times;</button>
    <img id="lightboxImg" src="" alt="Attachment preview" onclick="event.stopPropagation()" />
</div>

@section Scripts {
<script src="https://unpkg.com/tributejs@5.1.3/dist/tribute.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var users = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AssignableUsers ?? new List<CentralLicenceApp.Models.UserMaster>()));
        var mappedUsers = users.map(function(u) { return { key: u.FullName, value: u.FullName }; });

        var tribute = new Tribute({
            values: mappedUsers,
            selectTemplate: function(item) {
                return '@@' + item.original.value;
            },
            menuItemTemplate: function (item) {
                return item.string;
            }
        });

        var commentInput = document.getElementById('commentInput');
        if (commentInput) {
            tribute.attach(commentInput);
        }
    });

    function openLightbox(src, alt) {
        var lb = document.getElementById('lightbox');
        document.getElementById('lightboxImg').src = src;
        document.getElementById('lightboxImg').alt = alt;
        lb.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
        document.getElementById('lightbox').style.display = 'none';
        document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeLightbox();
    });

    function deleteAttachment(attId) {
        if (!confirm('Delete this attachment permanently?')) return;
        var token = document.getElementById('td-csrf').value;
        var fd = new FormData();
        fd.append('id', attId);
        fd.append('__RequestVerificationToken', token);
        fetch('@Url.Action("DeleteAttachment", "DailyTaskLog")', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(function(d) {
                if (d.success) {
                    var row = document.getElementById('td-att-' + attId);
                    if (row) {
                        row.style.transition = 'opacity .3s';
                        row.style.opacity = '0';
                        setTimeout(function() {
                            row.remove();
                            var grid = document.getElementById('attGrid');
                            if (grid && grid.querySelectorAll('.td-att-row').length === 0)
                                location.reload();
                        }, 320);
                    }
                } else {
                    alert(d.message || 'Failed to delete.');
                }
            });
    }
</script>
}

@functions {
    string FormatTime(int minutes)
    {
        if (minutes == 0) return "0m";
        var h = minutes / 60;
        var m = minutes % 60;
        if (h == 0) return $"{m}m";
        if (m == 0) return $"{h}h";
        return $"{h}h {m}m";
    }
}
