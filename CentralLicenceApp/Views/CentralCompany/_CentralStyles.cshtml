<style>
    .cc-head { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; margin-bottom:1.25rem; }
    .cc-title { display:flex; align-items:center; gap:12px; min-width:0; }
    .cc-title-icon { width:46px; height:46px; border-radius:12px; background:linear-gradient(135deg,#6366f1,#4f46e5); display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.25rem; flex-shrink:0; }
    .cc-title h4 { font-weight:700; color:#1e293b; margin:0; overflow-wrap:anywhere; }
    .cc-title p { font-size:.83rem; color:#64748b; margin:0; }
