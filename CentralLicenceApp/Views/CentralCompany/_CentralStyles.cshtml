    .cc-avatar { width:44px; height:44px; border-radius:12px; background:#eef2ff; color:#4f46e5; display:flex; align-items:center; justify-content:center; font-weight:800; flex-shrink:0; }
    .cc-name { font-weight:700; color:#0f172a; font-size:.98rem; overflow-wrap:anywhere; }
    .cc-code { display:inline-block; font-size:.72rem; font-weight:700; color:#4f46e5; background:#eef2ff; border-radius:6px; padding:2px 7px; margin-top:3px; }
    .cc-meta { padding:0 1.1rem .9rem; display:grid; grid-template-columns:1fr 1fr; gap:.55rem .9rem; font-size:.8rem; }
    .cc-label { font-size:.68rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.04em; }
    .cc-value { color:#1e293b; overflow-wrap:anywhere; font-variant-numeric:tabular-nums; }
