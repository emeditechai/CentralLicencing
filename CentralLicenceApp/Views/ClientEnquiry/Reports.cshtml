@model CentralLicenceApp.Models.ViewModels.EnquiryReportsViewModel
@{
    ViewData["Title"] = "Enquiry Reports";
    var funnelMax = Math.Max(1, Model.Funnel.Any() ? Model.Funnel.Max(f => f.Total) : 1);
}
<partial name="_EnquiryStyles" />
<div class="eq-head">
    <div class="eq-title"><div class="eq-title-icon"><i class="bi bi-bar-chart-line"></i></div><div><h4>Enquiry Reports</h4><p>Funnel, sources, calls, demos and team activity</p></div></div>
    <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
        <div><label class="eq-label" for="rFrom">From</label><input id="rFrom" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
        <div><label class="eq-label" for="rTo">To</label><input id="rTo" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
        <button class="btn btn-sm btn-primary">Apply</button>
        <a asp-action="ExportExcel" asp-permission="ClientEnquiry:Export" asp-route-From="@Model.From.ToString("yyyy-MM-dd")" asp-route-To="@Model.To.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Export enquiries</a>
    </form>
</div>
<div class="row g-3 mb-3">
    <div class="col-lg-6"><div class="eq-card h-100"><div class="eq-card-head">Current funnel</div><div class="eq-card-body">
        @foreach (var p in Model.Funnel)
        {
            <div class="mb-2"><div class="d-flex justify-content-between" style="font-size:.83rem;"><span>@p.Name</span><span><strong>@p.Total</strong> · ₹@p.Value.ToString("N0")</span></div><div class="eq-bar"><span style="width:@(100 * p.Total / funnelMax)%;background:@p.Color;"></span></div></div>
        }
    </div></div></div>
    <div class="col-lg-6"><div class="eq-card h-100"><div class="eq-card-head">Source performance</div><div class="table-responsive"><table class="table eq-table mb-0">
        <thead><tr><th>Source</th><th class="text-end">Enquiries</th><th class="text-end">Won</th><th class="text-end">Value</th></tr></thead>
        <tbody>@if (!Model.Sources.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">No data for this period.</td></tr> }
        @foreach (var s in Model.Sources) { <tr><td>@s.Name</td><td class="text-end">@s.Total</td><td class="text-end">@s.Won</td><td class="text-end">₹@s.Value.ToString("N0")</td></tr> }</tbody>
    </table></div></div></div>
</div>
<div class="row g-3 mb-3">
    @foreach (var (title, rows) in new[] { ("Call outcomes", Model.Calls), ("Demo outcomes", Model.Demos), ("Lost reasons", Model.LostReasons) })
    {
        <div class="col-lg-4"><div class="eq-card h-100"><div class="eq-card-head">@title</div><div class="eq-card-body">
            @if (!rows.Any()) { <div class="eq-sub">No data for this period.</div> }
            @foreach (var r in rows) { <div class="d-flex justify-content-between" style="font-size:.86rem;padding:3px 0;"><span>@r.Name</span><strong>@r.Total</strong></div> }
        </div></div></div>
    }
</div>
<div class="eq-card"><div class="eq-card-head">User activity</div><div class="table-responsive"><table class="table eq-table mb-0">
    <thead><tr><th>User</th><th class="text-end">Open</th><th class="text-end">Won</th><th class="text-end">Lost</th><th class="text-end">Calls</th><th class="text-end">Connected</th><th class="text-end">Follow-ups done</th><th class="text-end">Overdue now</th><th class="text-end">Demos done</th></tr></thead>
    <tbody>@if (!Model.Users.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">No activity yet.</td></tr> }
    @foreach (var u in Model.Users) { <tr><td>@u.UserName</td><td class="text-end">@u.OpenEnquiries</td><td class="text-end">@u.Won</td><td class="text-end">@u.Lost</td><td class="text-end">@u.Calls</td><td class="text-end">@u.ConnectedCalls</td><td class="text-end">@u.FollowUpsDone</td><td class="text-end @(u.Overdue > 0 ? "eq-overdue" : "")">@u.Overdue</td><td class="text-end">@u.Demos</td></tr> }</tbody>
</table></div></div>
